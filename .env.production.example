# =====================================================================
# NutriPulse — PRODUCTION .env template (Hepsia / ResellersPanel)
# ---------------------------------------------------------------------
# Copy this to a file named `.env` in the project ROOT on the server
# (use Hepsia File Manager "Create/Edit file", or your local editor then
# upload). Fill in the <angle brackets>. Never commit this file.
#
# IMPORTANT: the app runs on MySQL, not SQLite (pdo_sqlite is not a target).
# Create the database + user first via Hepsia -> MySQL Databases.
# =====================================================================

APP_NAME=NutriPulse
APP_ENV=production
APP_KEY=<generate locally: php artisan key:generate --show>
APP_DEBUG=false
APP_URL=https://np.isiteguru.com

APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# --- Database (Hepsia MySQL) ---
# DB_HOST is usually 'localhost' on Hepsia, or the host shown in the
# MySQL section of CloudLogin (e.g. db1.hepsia.info). Use that exact value.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<hepsia_db_name>
DB_USERNAME=<hepsia_db_user>
DB_PASSWORD=<hepsia_db_password>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.np.isiteguru.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail ---
# Keep MAIL_MAILER=log for in-app notifications only (no emails sent).
# To actually send emails, switch to SMTP with your host's mail settings.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="NutriPulse <noreply@np.isiteguru.com>"
MAIL_FROM_NAME="${APP_NAME}"

# --- AI provider (Google Gemini) ---
# Paste a real key to turn on AI calorie estimates + dashboard insights.
# Leave GOOGLE_API_KEY empty to use the built-in heuristic fallback.
AI_PROVIDER=gemini
GOOGLE_API_KEY=
AI_MODEL_ESTIMATE=gemini-2.5-flash
AI_MODEL_INSIGHT=gemini-2.5-flash

# --- Health targets ---
BLOOD_SUGAR_UNIT=mg/dL
TARGET_FASTING_MIN=70
TARGET_FASTING_MAX=100
TARGET_POSTMEAL_MIN=100
TARGET_POSTMEAL_MAX=140

# --- First-run admin (seeded once during `migrate --seed`) ---
ADMIN_NAME=Mj
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<choose a strong password NOW, or change after first login>

# --- Temporary deploy token for deploy/web_deploy.php ---
# Generate a random one:  php -r "echo bin2hex(random_bytes(24));"
# This ONLY matters while public/_deploy.php exists on the server —
# DELETE that file as soon as deployment is finished.
DEPLOY_TOKEN=<long-random-token>